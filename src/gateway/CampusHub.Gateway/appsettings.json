{
  "Identity": {
    "Authority": "http://localhost:5101",
    "ClientId": "campushub-gateway",
    "ClientSecret": "gateway-dev-secret"
  },
  "Internal": {
    "ApiKey": "campus-dev-internal"
  },
  "Services": {
    "Identity": "http://localhost:5101",
    "Catalog": "http://localhost:5102",
    "Enrollment": "http://localhost:5103",
    "Payment": "http://localhost:5104",
    "Notification": "http://localhost:5105",
    "Access": "http://localhost:5106",
    "Chat": "http://localhost:5107"
  },
  "Ops": {
    "Services": [
      { "Name": "identity", "Url": "http://localhost:5101/health/ready" },
      { "Name": "catalog", "Url": "http://localhost:5102/health/ready" },
      { "Name": "enrollment", "Url": "http://localhost:5103/health/ready" },
      { "Name": "payment", "Url": "http://localhost:5104/health/ready" },
      { "Name": "notification", "Url": "http://localhost:5105/health/ready" },
      { "Name": "access", "Url": "http://localhost:5106/health/ready" },
      { "Name": "chat", "Url": "http://localhost:5107/health/ready" }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "enrollment-api": {
        "ClusterId": "enrollment",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/enrollments/{**catch-all}"
        }
      },
      "catalog-api": {
        "ClusterId": "catalog",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "notification-api": {
        "ClusterId": "notification",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "access-api": {
        "ClusterId": "access",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/access/{**catch-all}"
        }
      },
      "chat-api": {
        "ClusterId": "chat",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      },
      "chat-socket": {
        "ClusterId": "chat",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/socket.io/{**catch-all}"
        }
      },
      "chat-socket-root": {
        "ClusterId": "chat",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/socket.io"
        }
      },
      "spa": {
        "ClusterId": "shell",
        "Order": 1000,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "enrollment": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:20",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "catalog": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:20",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "notification": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:20",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5105/"
          }
        }
      },
      "access": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:20",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5106/"
          }
        }
      },
      "chat": {
        "HttpRequest": {
          "ActivityTimeout": "00:20:00"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:20",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5107/"
          }
        }
      },
      "shell": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:4200/"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
