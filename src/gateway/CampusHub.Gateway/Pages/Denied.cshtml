@page "/ops/denied"
@model DeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<h1>Access denied</h1>
<p class="ops-lede">The platform console is limited to platform administrators. Campus administrators use the <strong>Campus</strong> area in the student UI.</p>
<p class="d-flex flex-wrap gap-2">
    <a class="btn btn-primary" href="/campus">Campus dashboard</a>
    <a class="btn btn-outline-primary" href="/">Back to CampusHub</a>
    <a class="btn btn-outline-secondary" href="/login?returnUrl=/ops">Sign in as platform admin</a>
</p>
