{
  "ConnectionStrings": {
    "identity": "Data Source=identity.db"
  },
  "Identity": {
    "Issuer": "http://localhost:5101/",
    "GatewayClientSecret": "gateway-dev-secret",
    "ServiceClientSecret": "enrollment-dev-secret"
  },
  "Gateway": {
    "PublicOrigin": "http://localhost:5000"
  },
  "Internal": {
    "ApiKey": "campus-dev-internal"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenIddict": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
