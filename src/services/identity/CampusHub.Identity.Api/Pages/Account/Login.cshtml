@page
@model CampusHub.Identity.Api.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-card">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true">C</span>
        <strong>CampusHub</strong>
    </div>
    <h1>Sign in</h1>
    <p class="muted">Use a seeded development account to enter campus.</p>

    <form method="post" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <label>
            Email
            <input asp-for="Input.Email" autocomplete="username" />
        </label>
        <label>
            Password
            <input asp-for="Input.Password" autocomplete="current-password" />
        </label>
        <label class="inline">
            <input asp-for="Input.RememberMe" /> Remember me
        </label>
        <button type="submit">Sign in</button>
    </form>

    <div class="hints">
        <p><strong>student@campushub.local</strong></p>
        <p><strong>teacher@campushub.local</strong></p>
        <p><strong>admin@campushub.local</strong></p>
        <p>Password: <code>CampusHub!123</code></p>
    </div>
</div>
